# Streamlit Community Cloud → app → Settings → Secrets → paste this (filled in).
# Locally you can instead use config.yaml + credentials.json; this file is for deploy.

google_sheet_id = "your-sheet-id"
google_worksheet_name = "Sheet1"
openai_api_key = "sk-..."
gemini_api_key = "AIza..."
extraction_model = "gemini-2.5-flash"

# Paste the whole content of credentials.json here as a TOML table:
[gcp_service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "sheets-writer@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
